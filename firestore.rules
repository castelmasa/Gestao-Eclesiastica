rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Connectivity verification path
    match /test/{testId} {
      allow read, write: if true;
    }

    // Users and permissions
    match /users/{userId} {
      allow read, write: if isSignedIn() || request.auth.uid == userId;
    }

    // Church financial transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Church congregation members
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Church ministry assets and equipment
    match /assets/{assetId} {
      allow read, write: if true;
    }

    // Congregations and branches
    match /branches/{branchId} {
      allow read, write: if true;
    }

    // Calendar events and cultos
    match /events/{eventId} {
      allow read, write: if true;
    }

    // System notifications and alerts
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Access requests
    match /access_requests/{requestId} {
      allow read, write: if true;
    }

    // Pastoral counseling records and prayer requests
    match /pastoral_records/{recordId} {
      allow read, write: if true;
    }
    match /prayer_requests/{requestId} {
      allow read, write: if true;
    }

    // Social assistance
    match /social_beneficiaries/{id} {
      allow read, write: if true;
    }
    match /social_attendances/{id} {
      allow read, write: if true;
    }
    match /social_inventory/{id} {
      allow read, write: if true;
    }

    // System audit logs
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // Backup system and scheduler
    match /system_backups/{backupId} {
      allow read, write: if true;
    }
    match /backup_configs/{configId} {
      allow read, write: if true;
    }

    // Error and telemetry logs
    match /error_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isSignedIn();
    }

    // Secretaria documents and scanned files
    match /secretaria_files/{fileId} {
      allow read, write: if true;
    }

    // Supporting finance categories, catalog items, and suppliers
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    match /items/{itemId} {
      allow read, write: if true;
    }
    match /fornecedores/{fornecedorId} {
      allow read, write: if true;
    }

    // Escalas de ministérios e voluntários (Limpeza, Músicos, Dirigentes, Diaconato)
    match /escalas_limpeza/{id} {
      allow read, write: if true;
    }
    match /escalas_musicos/{id} {
      allow read, write: if true;
    }
    match /escalas_dirigentes/{id} {
      allow read, write: if true;
    }
    match /escalaDiaconato/{id} {
      allow read, write: if true;
    }
    match /celulaReports/{id} {
      allow read, write: if true;
    }
    match /kidsCheckins/{id} {
      allow read, write: if true;
    }

    // Configurações e parâmetros institucionais da igreja
    match /church_config/{configId} {
      allow read, write: if true;
    }
    match /config/{configId} {
      allow read, write: if true;
    }

    // Controle e auditoria de créditos de Inteligência Artificial por igreja
    match /church_ai_credits/{churchId} {
      allow read, write: if true;
    }
    match /ai_usage_logs/{id} {
      allow read, write: if true;
    }

    // Fechamento e trava de meses contábeis no financeiro
    match /closed_financial_months/{id} {
      allow read, write: if true;
    }

    // Safety net: deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
