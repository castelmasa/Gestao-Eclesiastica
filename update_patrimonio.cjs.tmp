import { motion } from "motion/react";
import React, { useState, useRef, useEffect } from "react"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle, DialogTrigger } from "@/components/ui/dialog"
import { Label } from "@/components/ui/label"
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select"
import { Plus, Search, FileText, Download, Paperclip, MessageSquare, QrCode, Printer, Activity } from "lucide-react"
import { toast } from "sonner"
import { QRCodeSVG } from "qrcode.react"
import jsPDF from "jspdf"
import autoTable from "jspdf-autotable"
import { logAction } from "@/lib/audit"
import { useAuth } from "@/contexts/AuthContext"
import { PieChart, Pie, Cell, Tooltip, Legend, ResponsiveContainer } from "recharts"
import * as XLSX from "xlsx"

const initialAssets = [
  { id: "PAT-001", tag: "EQP-001", name: "Mesa de Som Yamaha MG16XU", category: "Áudio e Vídeo", location: "Templo Principal", value: 3500.00, status: "Em uso", specs: "16 canais, efeitos SPX", notes: "Comprada em 2023", fileName: "nf-001.pdf", purchaseDate: "2023-01-15", depreciationRate: 10, lastMaintenance: "2024-05-10" },
  { id: "PAT-002", tag: "EQP-002", name: "Projetor Epson PowerLite", category: "Áudio e Vídeo", location: "Templo Principal", value: 4200.00, status: "Em uso", specs: "4000 lumens, Full HD", notes: "", fileName: "", purchaseDate: "2022-11-20", depreciationRate: 15, lastMaintenance: "" },
  { id: "PAT-003", tag: "MOB-001", name: "Cadeiras Plásticas Brancas (50 un)", category: "Mobiliário", location: "Salão Social", value: 1500.00, status: "Em uso", specs: "Plástico injetado", notes: "Lote 1", fileName: "", purchaseDate: "2024-02-01", depreciationRate: 5, lastMaintenance: "" },
  { id: "PAT-004", tag: "INF-001", name: "Notebook Dell Inspiron", category: "Informática", location: "Secretaria", value: 2800.00, status: "Manutenção", specs: "Core i5, 8GB RAM, 256GB SSD", notes: "Tela piscando", fileName: "", purchaseDate: "2021-08-05", depreciationRate: 20, lastMaintenance: "2025-01-12" },
]

export function Patrimonio() {
  const { user } = useAuth()
  const [assets, setAssets] = useState(initialAssets)
  const [searchTerm, setSearchTerm] = useState("")
  const [isAddModalOpen, setIsAddModalOpen] = useState(false)
  const [isReportModalOpen, setIsReportModalOpen] = useState(false)
  const [isLabelModalOpen, setIsLabelModalOpen] = useState(false)
  const [selectedAssetForLabel, setSelectedAssetForLabel] = useState<any>(null)

  const printRef = useRef<HTMLDivElement>(null)

  const filteredAssets = assets.filter(a => 
    a.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    a.id.toLowerCase().includes(searchTerm.toLowerCase()) ||
    a.tag.toLowerCase().includes(searchTerm.toLowerCase()) ||
    a.category.toLowerCase().includes(searchTerm.toLowerCase())
  )

  const [churchData, setChurchData] = useState<any>(null)

  useEffect(() => {
    const savedData = localStorage.getItem("churchConfig")
    if (savedData) {
      setChurchData(JSON.parse(savedData))
    }

    const savedAssets = localStorage.getItem("churchAssets")
    if (!savedAssets) {
      localStorage.setItem("churchAssets", JSON.stringify(initialAssets))
    } else {
      setAssets(JSON.parse(savedAssets))
    }
  }, [])

  const handleGenerateReport = (type: string) => {
    const doc = new jsPDF()
    
    if (churchData) {
      doc.setFontSize(16)
      doc.text(churchData.nome || "Igreja", 14, 15)
      doc.setFontSize(10)
      doc.text(`${churchData.endereco || ""} - ${churchData.cidade || ""}`, 14, 20)
      doc.text(`CNPJ: ${churchData.cnpj || ""}`, 14, 25)
      if (churchData.logoFileName) {
         doc.text(`(Logo: ${churchData.logoFileName})`, 150, 20) // Placeholder for logo
      }
    }

    doc.setFontSize(18)
    doc.text(`Relatório de Patrimônio: ${type}`, 14, churchData ? 35 : 22)
    doc.setFontSize(11)
    doc.text(`Gerado em: ${new Date().toLocaleDateString('pt-BR')}`, 14, churchData ? 42 : 30)

    let dataToPrint = assets
    if (type === "Bens em Manutenção") {
      dataToPrint = assets.filter(a => a.status === "Manutenção")
    }

    let headRow = [['Etiqueta', 'Descrição', 'Categoria', 'Localização', 'Status', 'Valor']];
    let tableData = [];

    if (type === "Inventário Detalhado") {
      headRow = [['Etiqueta', 'Descrição', 'Data de Compra', 'Status', 'Valor Aquisição']];
      tableData = dataToPrint.map(a => [
        a.tag,
        a.name,
        a.purchaseDate ? new Date(a.purchaseDate).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : "-",
        a.status,
        `R$ ${a.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`
      ])
      const total = dataToPrint.reduce((acc, curr) => acc + curr.value, 0)
      tableData.push(["", "", "", "TOTAL:", `R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`])
    } else {
      tableData = dataToPrint.map(a => [
        a.tag,
        a.name,
        a.category,
        a.location,
        a.status,
        `R$ ${a.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`
      ])
      const total = dataToPrint.reduce((acc, curr) => acc + curr.value, 0)
      tableData.push(["", "", "", "", "TOTAL:", `R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`])
    }

    autoTable(doc, {
      startY: churchData ? 48 : 36,
      head: headRow,
      body: tableData,
    })

    doc.save(`relatorio_patrimonio_${type.toLowerCase().replace(/ /g, '_')}.pdf`)
    toast.success(`Relatório (${type}) gerado com sucesso!`)
    setIsReportModalOpen(false)
  }

  const handleAddAsset = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault()
    const formData = new FormData(e.currentTarget)
    
    const file = formData.get("file") as File
    const fileName = file && file.size > 0 ? file.name : ""

    const newAsset = {
      id: `PAT-${String(assets.length + 1).padStart(3, '0')}`,
      tag: formData.get("tag") as string,
      name: formData.get("name") as string,
      category: formData.get("category") as string,
      location: formData.get("location") as string,
      value: parseFloat((formData.get("value") as string).replace(',', '.')),
      status: formData.get("status") as string,
      specs: formData.get("specs") as string,
      notes: formData.get("notes") as string,
      fileName: fileName,
      purchaseDate: formData.get("purchaseDate") as string,
      depreciationRate: parseFloat((formData.get("depreciationRate") as string) || "0"),
      lastMaintenance: formData.get("lastMaintenance") as string
    }

    setAssets([newAsset, ...assets])
    
    // Simulating save to localStorage for layout check
    const updated = [newAsset, ...assets];
    localStorage.setItem("churchAssets", JSON.stringify(updated));
    window.dispatchEvent(new Event('storage'));

    setIsAddModalOpen(false)
    toast.success("Bem patrimonial cadastrado com sucesso!")
    logAction("Criação de Patrimônio", `Ativo cadastrado: ${newAsset.name} (${newAsset.tag})`, user?.name || "Desconhecido")
  }

  const handleOpenLabelModal = (asset: any) => {
    setSelectedAssetForLabel(asset)
    setIsLabelModalOpen(true)
  }

  const handlePrintLabel = () => {
    const printContent = printRef.current
    if (printContent) {
      const originalContents = document.body.innerHTML
      document.body.innerHTML = printContent.innerHTML
      window.print()
      document.body.innerHTML = originalContents
      window.location.reload() // Reload to restore React state after messing with DOM
    }
  }

  const totalValue = assets.reduce((acc, curr) => acc + curr.value, 0)
  const maintenanceCount = assets.filter(a => a.status === 'Manutenção').length

  // Calculate data for Pie Chart
  const assetDistribution = assets.reduce((acc, asset) => {
      const category = asset.category || "Outros";
      const existing = acc.find((item: any) => item.name === category);
      if (existing) {
          existing.value += 1;
      } else {
          acc.push({ name: category, value: 1 });
      }
      return acc;
  }, [] as any[]);
  
  const COLORS = ['#0ea5e9', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#ec4899', '#64748b'];

  return (
    <motion.div 
      initial={{ opacity: 0 }} 
      animate={{ opacity: 1 }} 
      transition={{ duration: 0.3 }}
      className="space-y-6"
    >
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h2 className="text-3xl font-bold tracking-tight text-foreground">Patrimônio</h2>
          <p className="text-muted-foreground mt-1">Controle de bens tangíveis e relatórios de inventário.</p>
        </div>
        <div className="flex gap-2">
          <Dialog open={isReportModalOpen} onOpenChange={setIsReportModalOpen}>
            <DialogTrigger asChild>
              <Button variant="outline"><FileText className="mr-2 h-4 w-4" /> Relatórios</Button>
            </DialogTrigger>
            <DialogContent className="sm:max-w-[425px]">
              <DialogHeader>
                <DialogTitle>Opções de Relatórios</DialogTitle>
                <DialogDescription>
                  Selecione o tipo de relatório de patrimônio que deseja gerar.
                </DialogDescription>
              </DialogHeader>
              <div className="grid gap-4 py-4">
                <Button variant="outline" className="justify-start" onClick={() => handleGenerateReport("Inventário Completo")}>
                  <Download className="mr-2 h-4 w-4" /> Inventário Completo
                </Button>
                <Button variant="outline" className="justify-start" onClick={() => handleGenerateReport("Inventário Detalhado")}>
                  <Download className="mr-2 h-4 w-4" /> Inventário Detalhado
                </Button>
                <Button variant="outline" className="justify-start" onClick={() => handleGenerateReport("Bens em Manutenção")}>
                  <Download className="mr-2 h-4 w-4" /> Bens em Manutenção
                </Button>
                <Button variant="outline" className="justify-start" onClick={() => handleGenerateReport("Bens por Categoria")}>
                  <Download className="mr-2 h-4 w-4" /> Bens por Categoria
                </Button>
              </div>
            </DialogContent>
          </Dialog>
          
          <Dialog open={isAddModalOpen} onOpenChange={setIsAddModalOpen}>
            <DialogTrigger asChild>
              <Button><Plus className="mr-2 h-4 w-4" /> Novo Bem</Button>
            </DialogTrigger>
            <DialogContent className="sm:max-w-[600px] max-h-[90vh] overflow-y-auto">
              <DialogHeader>
                <DialogTitle>Novo Bem Patrimonial</DialogTitle>
                <DialogDescription>
                  Cadastre um novo equipamento ou mobiliário.
                </DialogDescription>
              </DialogHeader>
              <form onSubmit={handleAddAsset}>
                <div className="grid gap-4 py-4">
                  <div className="grid grid-cols-2 gap-4">
                    <div className="grid gap-2">
                      <Label htmlFor="tag">Etiqueta de Identificação</Label>
                      <Input id="tag" name="tag" placeholder="Ex: EQP-001" required />
                    </div>
                    <div className="grid gap-2">
                      <Label htmlFor="name">Descrição do Bem</Label>
                      <Input id="name" name="name" placeholder="Ex: Mesa de Som Yamaha" required />
                    </div>
                  </div>
                  <div className="grid grid-cols-2 gap-4">
                    <div className="grid gap-2">
                      <Label htmlFor="category">Categoria</Label>
                      <Input id="category" name="category" placeholder="Ex: Áudio e Vídeo" required />
                    </div>
                    <div className="grid gap-2">
                      <Label htmlFor="location">Localização</Label>
                      <Input id="location" name="location" placeholder="Ex: Templo Principal" required />
                    </div>
                  </div>
                  <div className="grid grid-cols-3 gap-4">
                    <div className="grid gap-2">
                      <Label htmlFor="purchaseDate">Data de Compra</Label>
                      <Input id="purchaseDate" name="purchaseDate" type="date" />
                    </div>
                    <div className="grid gap-2">
                      <Label htmlFor="depreciationRate">Depreciação (%/ano)</Label>
                      <Input id="depreciationRate" name="depreciationRate" type="number" step="0.1" placeholder="Ex: 10" />
                    </div>
                    <div className="grid gap-2">
                      <Label htmlFor="lastMaintenance">Últ. Manutenção</Label>
                      <Input id="lastMaintenance" name="lastMaintenance" type="date" />
                    </div>
                  </div>
                  <div className="grid grid-cols-2 gap-4">
                    <div className="grid gap-2">
                      <Label htmlFor="value">Valor Estimado (R$)</Label>
                      <Input 
                        id="value" 
                        name="value" 
                        type="text" 
                        placeholder="0.00" 
                        required 
                        onChange={(e) => {
                          e.target.value = e.target.value.replace(/[^0-9.,]/g, '');
                        }}
                        onBlur={(e) => {
                          let val = e.target.value.replace(',', '.');
                          const num = parseFloat(val);
                          if (!isNaN(num)) {
                            e.target.value = num.toFixed(2);
                          }
                        }}
                      />
                    </div>
                    <div className="grid gap-2">
                      <Label htmlFor="status">Status</Label>
                      <Select name="status" defaultValue="Em uso" required>
                        <SelectTrigger>
                          <SelectValue placeholder="Selecione..." />
                        </SelectTrigger>
                        <SelectContent>
                          <SelectItem value="Em uso">Em uso</SelectItem>
                          <SelectItem value="Manutenção">Em manutenção</SelectItem>
                          <SelectItem value="Doado">Doado</SelectItem>
                          <SelectItem value="Vendido">Vendido</SelectItem>
                          <SelectItem value="Baixado">Baixado (Descarte)</SelectItem>
                        </SelectContent>
                      </Select>
                    </div>
                  </div>
                  <div className="grid gap-2">
                    <Label htmlFor="specs">Especificação Técnica</Label>
                    <textarea 
                      id="specs" 
                      name="specs" 
                      placeholder="Detalhes técnicos do equipamento..."
                      className="flex min-h-[80px] w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-800 dark:bg-slate-950 dark:ring-offset-slate-950 dark:placeholder:text-slate-400 dark:focus-visible:ring-slate-300"
                    />
                  </div>
                  <div className="grid gap-2">
                    <Label htmlFor="notes">Observações Gerais</Label>
                    <textarea 
                      id="notes" 
                      name="notes" 
                      placeholder="Observações adicionais..."
                      className="flex min-h-[80px] w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm ring-offset-white placeholder:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 dark:border-slate-800 dark:bg-slate-950 dark:ring-offset-slate-950 dark:placeholder:text-slate-400 dark:focus-visible:ring-slate-300"
                    />
                  </div>
                  <div className="grid gap-2">
                    <Label htmlFor="file">Upload de Arquivo (Nota Fiscal, Manual)</Label>
                    <Input id="file" name="file" type="file" />
                  </div>
                </div>
                <DialogFooter>
                  <Button type="button" variant="outline" onClick={() => setIsAddModalOpen(false)}>Cancelar</Button>
                  <Button type="submit">Salvar Bem</Button>
                </DialogFooter>
              </form>
            </DialogContent>
          </Dialog>
        </div>
      </div>

      <Tabs defaultValue="inventario" className="w-full">
        <div className="flex justify-between items-center mb-4">
          <TabsList>
            <TabsTrigger value="inventario">Inventário</TabsTrigger>
            <TabsTrigger value="timeline">Linha do Tempo</TabsTrigger>
          </TabsList>
        </div>
        <TabsContent value="inventario" className="mt-0">
          <div className="grid gap-4 md:grid-cols-3">
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Total de Bens</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{assets.length}</div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Valor Estimado</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">
              R$ {totalValue.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
            </div>
          </CardContent>
        </Card>
        <Card>
          <CardHeader className="pb-2">
            <CardTitle className="text-sm font-medium">Em Manutenção</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-amber-600 dark:text-amber-500">{maintenanceCount}</div>
          </CardContent>
        </Card>
      </div>

            <div className="grid gap-4 md:grid-cols-3">
        <Card className="md:col-span-2">
            <CardHeader>
            <CardTitle>Inventário</CardTitle>
            </CardHeader>
            <CardContent>
            <div className="flex items-center justify-between mb-4">
                <div className="relative w-full max-w-sm">
                <Search className="absolute left-2.5 top-2.5 h-4 w-4 text-slate-500" />
                <Input
                    type="search"
                    placeholder="Buscar bens, etiquetas..."
                    className="pl-8"
                    value={searchTerm}
                    onChange={(e) => setSearchTerm(e.target.value)}
                />
                </div>
            </div>
            <Table>
                <TableHeader>
                <TableRow>
                    <TableHead>Etiqueta</TableHead>
                    <TableHead>Descrição</TableHead>
                    <TableHead className="hidden md:table-cell">Categoria</TableHead>
                    <TableHead className="hidden sm:table-cell">Localização</TableHead>
                    <TableHead className="hidden lg:table-cell">Valor (R$)</TableHead>
                    <TableHead>Estado</TableHead>
                    <TableHead className="text-right">Ações</TableHead>
                </TableRow>
                </TableHeader>
                <TableBody>
                {filteredAssets.length > 0 ? (
                    filteredAssets.map((asset) => (
                    <TableRow key={asset.id}>
                        <TableCell className="font-medium text-slate-900 dark:text-slate-100">{asset.tag}</TableCell>
                        <TableCell>{asset.name}</TableCell>
                        <TableCell className="hidden md:table-cell">{asset.category}</TableCell>
                        <TableCell className="hidden sm:table-cell">{asset.location}</TableCell>
                        <TableCell className="hidden lg:table-cell">R$ {asset.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</TableCell>
                        <TableCell>
                        <span className={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                            asset.status === 'Em uso' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400' :
                            asset.status === 'Manutenção' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400' :
                            ['Doado', 'Vendido', 'Baixado'].includes(asset.status) ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400' :
                            'bg-slate-100 text-slate-800 dark:bg-slate-900/30 dark:text-slate-400'
                        }`}>
                            {asset.status}
                        </span>
                        </TableCell>
                        <TableCell className="text-right">
                        <Button variant="ghost" size="icon" onClick={() => {
                            setSelectedAssetForLabel(asset);
                            setIsLabelModalOpen(true);
                        }}>
                            <QrCode className="h-4 w-4 text-slate-500 hover:text-slate-900 dark:hover:text-slate-100" />
                        </Button>
                        </TableCell>
                    </TableRow>
                    ))
                ) : (
                    <TableRow>
                    <TableCell colSpan={7} className="h-24 text-center">
                        Nenhum patrimônio encontrado.
                    </TableCell>
                    </TableRow>
                )}
                </TableBody>
            </Table>
            </CardContent>
        </Card>

        <Card className="md:col-span-1">
            <CardHeader>
                <CardTitle>Distribuição por Categoria</CardTitle>
            </CardHeader>
            <CardContent className="h-[300px]">
                {assetDistribution.length > 0 ? (
                    <ResponsiveContainer width="100%" height="100%">
                        <PieChart>
                            <Pie
                                data={assetDistribution}
                                cx="50%"
                                cy="50%"
                                labelLine={false}
                                outerRadius={80}
                                fill="#8884d8"
                                dataKey="value"
                            >
                                {assetDistribution.map((entry, index) => (
                                    <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                                ))}
                            </Pie>
                            <Tooltip formatter={(value) => [`${value} itens`, "Quantidade"]} />
                            <Legend />
                        </PieChart>
                    </ResponsiveContainer>
                ) : (
                    <div className="w-full h-full flex items-center justify-center text-muted-foreground text-sm">
                        Nenhum bem cadastrado.
                    </div>
                )}
            </CardContent>
        </Card>
      </div>
      </TabsContent>
      <TabsContent value="timeline" className="mt-0">
        
        <Card>
          <CardHeader>
            <CardTitle>Histórico de Movimentações</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="relative border-l border-muted ml-3 space-y-8 pb-4">
              {assets
                .filter(a => a.purchaseDate)
                .sort((a, b) => new Date(b.purchaseDate).getTime() - new Date(a.purchaseDate).getTime())
                .map((asset, index) => {
                  const isEntrada = !['Baixado', 'Doado', 'Vendido'].includes(asset.status);
                  return (
                    <div key={index} className="relative pl-6">
                      <span className={`absolute -left-3 flex h-6 w-6 items-center justify-center rounded-full ring-8 ring-background ${isEntrada ? 'bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600' : 'bg-red-100 dark:bg-red-900/30 text-red-600'}`}>
                        <Activity className="h-3 w-3" />
                      </span>
                      <div className="flex flex-col flex-1 gap-1">
                        <div className="text-sm text-muted-foreground">
                          {new Date(asset.purchaseDate).toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
                        </div>
                        <h4 className="text-base font-medium">{isEntrada ? 'Aquisição' : 'Baixa'} de Bem</h4>
                        <p className="text-sm text-muted-foreground">
                          {asset.name} (Tag: {asset.tag}) - {asset.category}
                        </p>
                        <p className="text-sm font-semibold">
                          Valor: R$ {asset.value.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
                        </p>
                      </div>
                    </div>
                  );
              })}
            </div>
          </CardContent>
        </Card>

      </TabsContent>
      </Tabs>

      <Dialog open={isLabelModalOpen} onOpenChange={setIsLabelModalOpen}>
        <DialogContent className="sm:max-w-[400px]">
          <DialogHeader>
            <DialogTitle>Etiqueta Patrimonial</DialogTitle>
            <DialogDescription>
              Visualize e imprima a etiqueta com QR Code para afixar no bem.
            </DialogDescription>
          </DialogHeader>
          
          {selectedAssetForLabel && (
            <div className="flex flex-col items-center justify-center py-6">
              {/* Printable Area */}
              <div 
                ref={printRef} 
                className="border-2 border-dashed border-slate-300 p-6 rounded-lg flex flex-col items-center bg-white text-black w-[300px]"
              >
                <h3 className="font-bold text-lg mb-1 text-center leading-tight">Igreja Central</h3>
                <p className="text-xs text-slate-500 mb-4 uppercase tracking-wider">Controle Patrimonial</p>
                
                <div className="bg-white p-2 rounded-md mb-4">
                  <QRCodeSVG 
                    value={JSON.stringify({ id: selectedAssetForLabel.id, tag: selectedAssetForLabel.tag })} 
                    size={120} 
                    level="M"
                  />
                </div>
                
                <div className="text-center w-full">
                  <p className="font-bold text-lg">{selectedAssetForLabel.tag}</p>
                  <p className="text-sm font-medium truncate w-full" title={selectedAssetForLabel.name}>
                    {selectedAssetForLabel.name}
                  </p>
                  <p className="text-xs text-slate-500 mt-1">ID: {selectedAssetForLabel.id}</p>
                </div>
              </div>
            </div>
          )}

          <DialogFooter>
            <Button variant="outline" onClick={() => setIsLabelModalOpen(false)}>Cancelar</Button>
            <Button onClick={handlePrintLabel}><Printer className="mr-2 h-4 w-4" /> Imprimir Etiqueta</Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </motion.div>
  )
}
